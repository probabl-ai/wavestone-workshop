#!/usr/bin/env bash
# Download creditcard.csv from Google Drive into ./data.
# FILE_ID is baked in; this script does not read .env.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
FILE_ID="1TG96N6lxz9ikIl2I7Z9X9PrqGkkkP8CE"
CSV="$ROOT/data/creditcard.csv"
ZIP="$ROOT/creditcard.csv.zip"
FORCE=0

usage() {
  cat <<'EOF'
Usage: ./download-data [--force]

  Download creditcard.csv.zip from Google Drive and unzip it to data/creditcard.csv.
  Skips the download when data/creditcard.csv is already present.

  --force   Download and overwrite even if the CSV exists.
EOF
}

for arg in "$@"; do
  case "$arg" in
    -h | --help)
      usage
      exit 0
      ;;
    --force)
      FORCE=1
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
done

if [[ -f "$CSV" && "$FORCE" -eq 0 ]]; then
  echo "already present: $CSV"
  exit 0
fi

command -v curl >/dev/null || {
  echo "curl is required." >&2
  exit 1
}
command -v unzip >/dev/null || {
  echo "unzip is required." >&2
  exit 1
}

cookie="$(mktemp "${TMPDIR:-/tmp}/gd.cookie.XXXXXX")"
html="$(mktemp "${TMPDIR:-/tmp}/gd.html.XXXXXX")"
cleanup() { rm -f "$cookie" "$html" "$ZIP"; }
trap cleanup EXIT

curl -c "$cookie" -sL "https://drive.google.com/uc?export=download&id=$FILE_ID" -o "$html"
uuid="$(sed -n 's/.*name="uuid" value="\([^"]*\)".*/\1/p' "$html" | head -1)"
if [[ -n "$uuid" ]]; then
  curl -b "$cookie" -L \
    "https://drive.usercontent.google.com/download?id=$FILE_ID&export=download&confirm=t&uuid=$uuid" \
    -o "$ZIP"
else
  curl -b "$cookie" -L \
    "https://drive.google.com/uc?export=download&id=$FILE_ID&confirm=t" \
    -o "$ZIP"
fi

unzip -t "$ZIP" >/dev/null || {
  echo "download did not produce a zip (is the Drive file shared with anyone with the link?)." >&2
  exit 1
}

mkdir -p "$ROOT/data"
unzip -o "$ZIP" -d "$ROOT/data"
[[ -f "$CSV" ]] || {
  echo "zip did not contain creditcard.csv" >&2
  exit 1
}

echo "wrote $CSV"
